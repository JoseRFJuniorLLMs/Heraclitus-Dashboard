# Dashboard local host
HERACLITUS_DASHBOARD_BIND=127.0.0.1
HERACLITUS_DASHBOARD_PORT=9337
# Comma-separated Host headers accepted by the local server (DNS rebinding guard).
HERACLITUS_DASHBOARD_ALLOWED_HOSTS=localhost:9337,127.0.0.1:9337,[::1]:9337

# HeraclitusDB core REST
HERACLITUS_REST_HOST=127.0.0.1
HERACLITUS_REST_PORT=7475
# Optional local auto-auth. Keep real values only in .env (which is gitignored).
# When both are set, the Python proxy authenticates to Core server-side so the
# dashboard starts already connected. Browser-provided credentials still override.
HERACLITUS_REST_USERNAME=
HERACLITUS_REST_PASSWORD=

# Optional Agent Evidence & Control / Agent Black Box API
HERACLITUS_AGENT_HOST=127.0.0.1
HERACLITUS_AGENT_PORT=8080
# Agent OIDC/Bearer credentials are deliberately NOT configured here. The dashboard
# accepts an optional Agent token in browser memory so Core credentials can never
# leak automatically into the Agent trust plane.

# Optional LABRA-AGU use-case runtime. In the LABRA-AGU repo run:
#   python3 serve.py --no-open
# Only GET /health and GET /devedores are proxied by the general dashboard.
LABRA_HOST=127.0.0.1
LABRA_PORT=8770

# Optional AEB-STREAM runtime. In the AEB repo run:
#   python3 dashboard.py
# Only its GET /api/data surface is exposed as /aeb-api/data.
AEB_HOST=127.0.0.1
AEB_PORT=7480

# Optional CGEE budget-integrity runtime. In the CGEE repo run:
#   python3 painel_server.py
# Only GET /api/stats, /api/timeline, /api/verify and /api/why are proxied.
CGEE_HOST=127.0.0.1
CGEE_PORT=8000

# Portal da Transparência API key. Keep server-side; never commit a real key.
PORTAL_TRANSPARENCIA_API_KEY=
